  - label: "\xC7\u0131k\u0131\u015F Butonu"
    turkish: "\xC7IKI\u015E"
    english: QUIT
  - label: "Ayarlar Ba\u015Fl\u0131\u011F\u0131"
    turkish: AYARLAR
    english: SETTINGS
  - label: "M\xFCzik Etiketi"
