  audioOnSprite: {fileID: 21300000, guid: 04e82f0c78c5a7c46a4d387e02652d51, type: 3}
  audioOffSprite: {fileID: 21300000, guid: 300785535542a524db8223518978143f, type: 3}
  musicVolumeSlider: {fileID: 903895011}
  sfxVolumeSlider: {fileID: 1514770672}
  vibrationToggle: {fileID: 1992573470}
  languageButtonText: {fileID: 1342016814}
  qualityButtonText: {fileID: 1473110480}
  sceneData: {fileID: 11400000, guid: f9e0e064c3f8b7448b0774421c7916af, type: 2}
  highScoreLabelIndex: 11
  gameSceneName: CityScene
  loadingPanel: {fileID: 269862490}
  loadingBar: {fileID: 1920764602}
  loadingPercentText: {fileID: 1180715505}
  loadingTipText: {fileID: 757160895}
  loadingBackground: {fileID: 269862492}
  minimumLoadingTime: 2
  backgroundStartColor: {r: 1, g: 1, b: 1, a: 1}
  backgroundEndColor: {r: 0.15, g: 0.15, b: 0.15, a: 1}
  loadingTips:
  - turkish: "\u0130pucu: Skorun hayatta kald\u0131\u011F\u0131n s\xFCreye g\xF6re
      artar; amac\u0131n ka\xE7mak."
    english: "Tip: Your score grows the longer you survive \u2014 your goal is to
      escape."
  - turkish: "\u0130pucu: Polisler sana \xE7arpt\u0131\u011F\u0131nda hasar al\u0131rs\u0131n,
      ama onlar da par\xE7alan\u0131r."
    english: 'Tip: Police cars damage you when they ram you, but they wreck themselves
      too.'
  - turkish: "\u0130pucu: Yak\u0131n\u0131nda par\xE7alanan polis ara\xE7lar\u0131ndan
      deneyim puan\u0131 kazan\u0131rs\u0131n."
    english: 'Tip: You earn XP from police cars wrecked near you.'
  - turkish: "\u0130pucu: Aranma y\u0131ld\u0131z\u0131n artt\u0131k\xE7a kazand\u0131\u011F\u0131n
      deneyim puan\u0131 da artar."
    english: 'Tip: The higher your wanted level, the more XP you earn.'
  - turkish: "\u0130pucu: Yoldaki kutular\u0131 topla; kalkan, h\u0131zlanma ve tamir
      seni hayatta tutar."
    english: "Tip: Collect the pickups on the road \u2014 shields, boosts and repairs
      keep you alive."
  - turkish: "\u0130pucu: Helikopterin b\u0131rakt\u0131\u011F\u0131 diken kapanlar\u0131na
      dikkat et, h\u0131z\u0131n\u0131 keser."
    english: "Tip: Watch out for the spike strips dropped by the helicopter \u2014
      they slow you down."
  - turkish: "\u0130pucu: Barikatlarda her zaman bir bo\u015Fluk vard\u0131r, do\u011Fru
      \u015Feridi se\xE7."
    english: "Tip: Roadblocks always have a gap \u2014 pick the right lane."
  - turkish: "\u0130pucu: Seviye atlad\u0131\u011F\u0131nda \xE7\u0131kan kartlardan
      birini se\xE7erek arac\u0131n\u0131 g\xFC\xE7lendir."
    english: 'Tip: When you level up, pick a card to upgrade your car.'
